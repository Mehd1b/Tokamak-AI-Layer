# -------------------------------------------------------------------------
# Prover Service Configuration
# -------------------------------------------------------------------------

# Network bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Listening port (default: 3001)
PORT=3001

# Rust log filter (default: prover_service=info,tower_http=info)
RUST_LOG=prover_service=info,tower_http=info

# Number of concurrent proof workers (default: 1).
# Increase if the host has enough CPU / GPU resources for parallel proving.
WORKER_CONCURRENCY=1

# API keys — comma-separated list of key:name:tier triples.
# Tiers: "free" (10 req/hr) or "paid" (100 req/hr).
# If empty, a default dev key "dev-test-key" with paid tier is created.
#
# Example:
#   API_KEYS=sk-prod-abc123:acme-corp:paid,sk-trial-xyz:demo-user:free
API_KEYS=
